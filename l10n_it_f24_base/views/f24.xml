<odoo>
    <record id="view_l10n_it_f24_tree" model="ir.ui.view">
        <field name="name">l10n_it.f24.tree</field>
        <field name="model">l10n_it.f24</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date" />
                <field name="payment_date" />
                <field name="amount" />
            </list>
        </field>
    </record>

    <record id="view_l10n_it_f24_form" model="ir.ui.view">
        <field name="name">l10n_it.f24.form</field>
        <field name="model">l10n_it.f24</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_confirm"
                        string="Conferma"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_print_f24"
                        string="Scarica F24"
                        type="object"
                        class="oe_highlight"
                    />

                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="date" />
                        <field name="payment_date" />
                        <field name="company_id" />
                        <field name="bank_account_id" />
                        <field name="fornitore_birth_place" />
                        <field name="fornitore_birth_province" />
                        <field name="move_id" />
                        <field name="create_move" />
                        <field name="protocol_number" />
                        <field name="amount" />
                    </group>
                    <notebook>
                        <page string="F24 Lines">
                            <group string="Erario">
                                <field
                                    name="f24line_ids"
                                    domain="[('section','=','erario')]"
                                >
                                    <list editable="bottom" limit="6">
                                        <field
                                            name="codice_tributo"
                                            options="{'no_create': True}"
                                        />
                                        <field name="rateazione" />
                                        <field name="ref_year" />
                                        <field
                                            name="certification_number"
                                            optional="hide"
                                        />
                                        <field name="debit" sum="Total" />
                                        <field name="credit" sum="Total" />
                                        <field
                                            name="debit_account_id"
                                            optional="hide"
                                        />
                                        <field
                                            name="credit_account_id"
                                            optional="hide"
                                        />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Move" invisible="not move_id">
                            <field name="move_id">
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="date" />
                                            <field name="ref" />
                                            <field name="journal_id" />
                                        </group>
                                        <notebook>
                                            <page string="Lines">
                                                <field name="line_ids">
                                                    <list>
                                                        <field
                                                            name="currency_id"
                                                            optional="hide"
                                                        />
                                                        <field name="name" />
                                                        <field name="account_id" />
                                                        <field
                                                            name="debit"
                                                            sum="Total"
                                                        />
                                                        <field
                                                            name="credit"
                                                            sum="Total"
                                                        />
                                                        <field
                                                            name="amount_residual"
                                                            optional="hide"
                                                        />
                                                    </list>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_l10n_it_f24" model="ir.actions.act_window">
        <field name="name">F24</field>
        <field name="res_model">l10n_it.f24</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_l10n_it_f24"
        name="F24"
        parent="account.menu_finance_entries"
        action="action_l10n_it_f24"
        sequence="90"
    />

    <record id="l10n_it_f24_base_tribute_code_tree" model="ir.ui.view">
        <field name="name">l10n.it.f24.tributecode.tree</field>
        <field name="model">l10n_it.f24.tributecode</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" />
                <field name="description" />
            </list>
        </field>
    </record>

    <record id="l10n_it_f24_base_tribute_code_form" model="ir.ui.view">
        <field name="name">l10n.it.f24.tributecode.form</field>
        <field name="model">l10n_it.f24.tributecode</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="description" />
                        <field name="active" />
                        <field name="usage_mode" />
                        <field name="section" />
                        <field name="rateazione" />
                        <field name="ref_year" />
                        <field name="office_code" />
                        <field name="act_code" />
                        <field name="max_ref_year" />
                        <field name="debit_account_id" />
                        <field name="credit_account_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_it_f24_tribute_code" model="ir.actions.act_window">
        <field name="name">F24 Tribute Codes</field>
        <field name="res_model">l10n_it.f24.tributecode</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="l10n_it_f24_base_tribute_code_tree" />
    </record>

    <record id="l10n_it_f24_tribute_codes_menuitem" model="ir.ui.menu">
        <field name="name">F24 Tribute Codes</field>
        <field name="parent_id" ref="account.account_account_menu" />
        <field name="action" ref="action_l10n_it_f24_tribute_code" />
        <field name="sequence" eval="20" />
    </record>

    <record id="l10n_it_f24_base_account_tax_form_inherit" model="ir.ui.view">
        <field name="name">account.tax.form.l10n.it.f24.base.inherit</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_group_id']" position="after">
                <field name="l10n_it_f24_codice_tributo_id" />
            </xpath>
        </field>
    </record>

    <record id="res_company_form_inherit_l10n_it_f24_base" model="ir.ui.view">
        <field name="name">res.company.form.l10n.it.f24.base.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="F24">
                    <field name="l10n_it_account_f24_journal_id" />
                    <field name="l10n_it_account_f24_clearing_account_id" />
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_partner_bank_form_inherit_l10n_it_f24_base" model="ir.ui.view">
        <field name="name">res.partner.bank.form.l10n.it.f24.base.inherit</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bank_id']" position="after">
                <field name="l10n_it_is_f24_payment" />
            </xpath>
        </field>
    </record>
</odoo>
